{
  "manifest_version": 3,
  "name": "Privacy-Preserving Visual Browser Agent",
  "version": "0.1.0",
  "description": "On-device PII redaction for a lightweight browser agent. Raw sensitive data never leaves this device.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_permissions": ["debugger"],
  "host_permissions": ["http://localhost:8001/*", "http://127.0.0.1:8001/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Privacy Browser Agent"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
