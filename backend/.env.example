# Copy this file to backend/.env and fill in your own values.
# .env is gitignored — your real key never gets committed.
#
# Once this file exists, `uvicorn app.main:app --port 8001` will pick it up
# automatically on every start — no need to $env:/export these each time.

# Leave commented (mock provider, no API key needed) unless you want the
# real hosted VLM:
# VLM_PROVIDER=qwen
# OPENROUTER_API_KEY=sk-or-your-key-here

# Rarely needed to change for local development:
# AGENT_API_KEY=dev-local-only-key
# AGENT_TOKEN_SECRET=dev-local-only-secret-change-me
# ALLOWED_ORIGINS=*
